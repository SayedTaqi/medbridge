# RevenueCat public SDK keys
# RevenueCat Dashboard -> Project Settings -> API Keys
# Never put RevenueCat secret keys in the mobile app.

EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxx

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# --- AWS S3 (Prescription Storage) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=medbridge-prescriptions

# --- Razorpay / Payment Gateway ---
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
