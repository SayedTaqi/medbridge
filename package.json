{
  "name": "medbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "api:dev": "tsx watch server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "build:api": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx seed.ts",
    "test": "NODE_ENV=test tsx --test api.test.ts",
    "prisma:validate": "prisma validate --schema=./schema.prisma",
    "prisma:generate": "prisma generate --schema=./schema.prisma",
    "db:push": "prisma db push --schema=./schema.prisma",
    "prisma:migrate": "prisma db push --schema=./schema.prisma",
    "mobile:start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.750.0",
    "@aws-sdk/s3-request-presigner": "3.750.0",
    "@prisma/client": "6.0.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "expo": "53.0.0",
    "expo-dev-client": "~5.2.4",
    "expo-location": "18.0.0",
    "expo-notifications": "0.31.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "react": "19.0.0",
    "react-native": "0.79.0",
    "react-native-purchases": "9.6.15",
    "react-native-purchases-ui": "9.6.15",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.0",
    "@types/react": "19.0.0",
    "prisma": "6.0.0",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
"devDependencies": {
  "@react-native-community/cli": "latest"
}
